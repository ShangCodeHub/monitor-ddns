# 配置示例：复制为 config.env 后填写真实值，勿提交 config.env
# 阿里云与西部数码的密钥仅保存在本地，不要提交到 Git

# ---------- 阿里云短信 ----------
SMS_ALIYUN_ENABLED=true
SMS_ALIYUN_REGION_ID=cn-hangzhou
SMS_ALIYUN_ACCESS_KEY_ID=
SMS_ALIYUN_ACCESS_KEY_SECRET=
SMS_ALIYUN_SIGN_NAME=
SMS_ALIYUN_TEMPLATE_CODE=
SMS_ALIYUN_TEMPLATE_PARAM_NAME=code
SMS_ALIYUN_PHONE_NUMBERS=
SMS_COOLDOWN_SECONDS=3600

# ---------- 域名监控 ----------
MONITOR_ENABLED=true
MONITOR_INTERVAL=600
MONITOR_URLS=
MONITOR_TIMEOUT=10
MONITOR_CHECK_TYPE=ping

# ---------- 西部数码 DDNS ----------
WESTCN_DOMAIN=
WESTCN_APIKEY=
WESTCN_HOSTNAMES=
